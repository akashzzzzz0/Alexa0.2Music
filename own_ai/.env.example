# Local Ollama configuration (the Docker startup script sets these automatically)
ALEXA_AI_ENGINE=ollama
OLLAMA_MODEL=qwen3:4b
ALEXA_AI_BASE_URL=http://127.0.0.1:11434/v1
ALEXA_AI_MODEL=qwen3:4b

# Set a long random value in the hosting dashboard to protect the API.
ALEXA_OWN_AI_TOKEN=replace-with-a-long-random-secret

# Mount persistent storage at /data to retain model files and SQLite memory.
ALEXA_AI_MEMORY_DB=/data/alexa_memory.sqlite3
ALEXA_AI_LEARNING_DB=/data/alexa_learning.sqlite3
