# Alexa Music (based on antlis/tg-streaming-bot)
BOT_TOKEN=
API_ID=
API_HASH=
# Legacy Alexa variable; config.py maps this to SESSION_NAME
SESSION_STRING=
# Legacy Alexa variable; config.py maps this to SUDO_USERS
OWNER_ID=
BOT_NAME=Alexa
# Optional bot username without @
BOT_USERNAME=
# Legacy Alexa DURATION_LIMIT is seconds; values > 1440 are converted to minutes.
DURATION_LIMIT=3600
# Optional explicit override in minutes, if desired
# ALEXA_DURATION_LIMIT_MINUTES=60
# Optional: GROUP_SUPPORT=+invitehash
# Optional: UPDATES_CHANNEL=+invitehash
