# Copy into EthioDeploy service variables. Never commit real secrets.
PORT=8000
ALEXA_LOCAL_MODEL_ENABLED=true
ALEXA_LOCAL_MODEL_REPO=Qwen/Qwen3-4B-GGUF
ALEXA_LOCAL_MODEL_FILE=Qwen3-4B-Q4_K_M.gguf
