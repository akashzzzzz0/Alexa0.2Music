# Copy these into the EthioDeploy service variables; never commit real secrets.
PORT=8000
ALEXA_AI_BASE_URL=
ALEXA_AI_MODEL=
ALEXA_AI_API_KEY=
ALEXA_OWN_AI_TOKEN=
ALEXA_AI_TIMEOUT=90
# Set these to a persistent mounted volume on EthioDeploy if available.
ALEXA_AI_MEMORY_DB=/data/alexa_own_ai_memory.sqlite3
ALEXA_AI_LEARNING_DB=/data/alexa_own_ai_learning.sqlite3
