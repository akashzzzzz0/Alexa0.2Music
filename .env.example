# Copy these into EthioDeploy service variables. Never commit real secrets.
PORT=8000
ALEXA_AI_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
ALEXA_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
ALEXA_AI_API_KEY=
ALEXA_AI_TIMEOUT=180
ALEXA_OWN_AI_TOKEN=
# Keep existing SQLite DB path settings unchanged if already configured.
# ALEXA_AI_MEMORY_DB=/data/alexa_own_ai_memory.sqlite3
# ALEXA_AI_LEARNING_DB=/data/alexa_own_ai_learning.sqlite3
